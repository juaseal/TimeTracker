<Window x:Class="TimeTracker.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskUp Settings" Width="1080" Height="820" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                    <Path Data="{StaticResource CalendarIcon}" Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Settings" FontSize="{DynamicResource FontSizeWindowTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="Customize the application, weekly templates, and recurring periods" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Display preferences" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Configure the weekly period and the content of each recent task" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}"/>
                            </StackPanel>
                            <TextBlock x:Name="PreferencesStatusText" Grid.Column="2" Foreground="{DynamicResource Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Start of week" FontWeight="SemiBold"/>
                                    <TextBlock Text="All weekly views span seven days from the selected day." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,10"/>
                                    <ComboBox x:Name="WeekStartBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                    <TextBlock Text="Example: Friday creates periods from Friday through Thursday." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,8,0,0"/>
                                    <Separator Margin="0,14,0,10"/>
                                    <TextBlock Text="SAP reporting" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="RoundSapBox" Content="Round hours for SAP" Margin="5,8,5,4"/>
                                    <TextBlock Text="Increment" Style="{StaticResource MutedText}" Margin="4,4,4,0"/>
                                    <ComboBox x:Name="RoundingMinutesBox" IsEnabled="{Binding IsChecked, ElementName=RoundSapBox}">
                                        <ComboBoxItem Tag="5" Content="5 minutes"/>
                                        <ComboBoxItem Tag="10" Content="10 minutes"/>
                                        <ComboBoxItem Tag="15" Content="15 minutes"/>
                                        <ComboBoxItem Tag="20" Content="20 minutes"/>
                                        <ComboBoxItem Tag="25" Content="25 minutes"/>
                                        <ComboBoxItem Tag="30" Content="30 minutes"/>
                                    </ComboBox>
                                    <TextBlock Text="Each daily entry is rounded to the nearest increment. Recorded time does not change." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,6"><TextBlock Text="Recent limit" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><ComboBox x:Name="RecentLimitBox" Width="80" Margin="10,0,0,0" IsEditable="True"><ComboBoxItem Content="10"/><ComboBoxItem Content="20"/><ComboBoxItem Content="30"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/></ComboBox></StackPanel>
                                <TextBlock Grid.Row="1" Text="Visible fields · select a row to change its position" Style="{StaticResource MutedText}" Margin="4,0,0,6"/>
                                <DataGrid x:Name="RecentFieldsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                        <DataGridTextColumn Header="Field" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Bold" Binding="{Binding IsBold, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="↑  Move up" Click="MoveFieldUpClick"/>
                                    <Button Content="↓  Move down" Click="MoveFieldDownClick"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Appearance" FontWeight="SemiBold"/>
                                    <TextBlock Text="Theme" Style="{StaticResource MutedText}" Margin="4,9,4,0"/>
                                    <ComboBox x:Name="ThemeBox">
                                        <ComboBoxItem Tag="light" Content="Light"/><ComboBoxItem Tag="dark" Content="Dark"/>
                                    </ComboBox>
                                    <TextBlock Text="Color palette" Style="{StaticResource MutedText}" Margin="4,6,4,0"/>
                                    <ComboBox x:Name="PaletteBox">
                                        <ComboBoxItem Tag="violet" Content="Violet"/><ComboBoxItem Tag="blue" Content="Blue"/><ComboBoxItem Tag="green" Content="Green"/><ComboBoxItem Tag="orange" Content="Orange"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Accessibility" FontWeight="SemiBold"/>
                                    <TextBlock Text="Font size" Style="{StaticResource MutedText}" Margin="4,9,4,0"/>
                                    <ComboBox x:Name="FontScaleBox">
                                        <ComboBoxItem Tag="0.9" Content="Compact (90 %)"/><ComboBoxItem Tag="1" Content="Normal (100 %)"/><ComboBoxItem Tag="1.15" Content="Large (115 %)"/><ComboBoxItem Tag="1.3" Content="Very large (130 %)"/><ComboBoxItem Tag="1.5" Content="Maximum (150 %)"/>
                                    </ComboBox>
                                    <CheckBox x:Name="HighContrastBox" Content="High contrast" Margin="5,9,5,3" ToolTip="Increases contrast for borders and secondary text"/>
                                    <CheckBox x:Name="ReducedMotionBox" Content="Reduce motion" Margin="5,3" ToolTip="Avoids current or future decorative animations"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Widget mode" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="StartInWidgetBox" Content="Start in widget mode" Margin="5,10,5,3"/>
                                    <CheckBox x:Name="AlwaysOnTopBox" Content="Always on top" Margin="5,3"/>
                                    <TextBlock Text="The widget remembers its position. Escape returns to the full application." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeSmall}" Margin="5,9,5,0"/>
                                    <Separator Margin="0,12,0,8"/>
                                    <TextBlock Text="Data and support" FontWeight="SemiBold"/>
                                    <Button Content="Export history CSV" Click="ExportDataClick" Margin="0,7,0,2" AutomationProperties.Name="Export history to CSV"/>
                                    <Button Content="Create backup" Click="BackupDataClick" Margin="0,2" AutomationProperties.Name="Create backup"/>
                                    <Button Content="Open data folder" Click="OpenDataFolderClick" Margin="0,2" AutomationProperties.Name="Open data and diagnostics folder"/>
                                    <Button Content="About TaskUp" Click="AboutClick" Margin="0,2" AutomationProperties.Name="Information and privacy"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Grid.Row="5" Content="Save preferences" Click="SavePreferencesClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Weekly templates" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Configure expected hours for each day in a weekly template" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TemplateModeText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Template" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <ComboBox x:Name="TemplateBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="TemplateSelected"/>
                            <Button Grid.Column="2" Content="+  New template" Click="NewTemplateClick" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Template name" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="TemplateNameBox" Margin="0,5,0,0"/>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="12" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="How to enter hours" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="Use 8.5. Enter 0 for non-working days." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid x:Name="ScheduleDaysGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False" RowHeight="25" MinRowHeight="25">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Day of week" Binding="{Binding Day}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Hours" Binding="{Binding Hours}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Delete template" Click="DeleteTemplateClick" Style="{StaticResource DangerButton}"/>
                            <Button Content="Save template" Click="SaveTemplateClick" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18" MinHeight="360">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Success}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Calendar periods" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Assign a template to a recurring interval · Dates use dd/MM format" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="PeriodModeText" Foreground="{DynamicResource Success}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid x:Name="PeriodsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="PeriodSelected" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Period" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="From" Binding="{Binding StartText}" Width="76"/>
                                        <DataGridTextColumn Header="To" Binding="{Binding EndText}" Width="76"/>
                                        <DataGridTextColumn Header="Template" Binding="{Binding TemplateName}" Width="210"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Period details" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Grid.Row="1" Text="Name" Style="{StaticResource MutedText}" Margin="4,12,4,0"/>
                                    <TextBox Grid.Row="2" x:Name="PeriodNameBox"/>
                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="From (dd/MM)" Style="{StaticResource MutedText}" Margin="4,0"/><TextBox x:Name="PeriodStartBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="To (dd/MM)" Style="{StaticResource MutedText}" Margin="4,0"/><TextBox x:Name="PeriodEndBox"/></StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock Text="Weekly template" Style="{StaticResource MutedText}" Margin="4,0"/><ComboBox x:Name="PeriodTemplateBox" DisplayMemberPath="Name"/></StackPanel>
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                        <Button Content="New" Click="NewPeriodClick"/>
                                        <Button Content="Delete" Click="DeletePeriodClick" Style="{StaticResource DangerButton}"/>
                                        <Button Content="Save" Click="SavePeriodClick" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
