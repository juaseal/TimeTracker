<Window x:Class="TimeTracker.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de TimeTracker" Width="1080" Height="820" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                    <Path Data="{StaticResource CalendarIcon}" Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Configuración" FontSize="{DynamicResource FontSizeWindowTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="Personaliza la aplicación, las semanas tipo y los periodos recurrentes" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Preferencias de visualización" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Configura el periodo semanal y el contenido de cada tarea reciente" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}"/>
                            </StackPanel>
                            <TextBlock x:Name="PreferencesStatusText" Grid.Column="2" Foreground="{DynamicResource Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Inicio de la semana" FontWeight="SemiBold"/>
                                    <TextBlock Text="Todas las vistas semanales abarcarán siete días desde el día elegido." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,4,0,10"/>
                                    <ComboBox x:Name="WeekStartBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                    <TextBlock Text="Ejemplo: Viernes crea periodos de viernes a jueves." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,8,0,0"/>
                                    <Separator Margin="0,14,0,10"/>
                                    <TextBlock Text="Imputación en SAP" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="RoundSapBox" Content="Redondear las horas para SAP" Margin="5,8,5,4"/>
                                    <TextBlock Text="Resolución" Style="{StaticResource MutedText}" Margin="4,4,4,0"/>
                                    <ComboBox x:Name="RoundingMinutesBox" IsEnabled="{Binding IsChecked, ElementName=RoundSapBox}">
                                        <ComboBoxItem Tag="5" Content="5 minutos"/>
                                        <ComboBoxItem Tag="10" Content="10 minutos"/>
                                        <ComboBoxItem Tag="15" Content="15 minutos"/>
                                        <ComboBoxItem Tag="20" Content="20 minutos"/>
                                        <ComboBoxItem Tag="25" Content="25 minutos"/>
                                        <ComboBoxItem Tag="30" Content="30 minutos"/>
                                    </ComboBox>
                                    <TextBlock Text="Se redondea cada imputación diaria al incremento más cercano. El tiempo registrado no cambia." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Campos de Recientes · selecciona una fila para cambiar su posición" Style="{StaticResource MutedText}" Margin="4,0,0,6"/>
                                <DataGrid x:Name="RecentFieldsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                        <DataGridTextColumn Header="Campo" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Negrita" Binding="{Binding IsBold, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="↑  Subir" Click="MoveFieldUpClick"/>
                                    <Button Content="↓  Bajar" Click="MoveFieldDownClick"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Apariencia" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tema" Style="{StaticResource MutedText}" Margin="4,9,4,0"/>
                                    <ComboBox x:Name="ThemeBox">
                                        <ComboBoxItem Tag="light" Content="Claro"/><ComboBoxItem Tag="dark" Content="Oscuro"/>
                                    </ComboBox>
                                    <TextBlock Text="Paleta de color" Style="{StaticResource MutedText}" Margin="4,6,4,0"/>
                                    <ComboBox x:Name="PaletteBox">
                                        <ComboBoxItem Tag="violet" Content="Violeta"/><ComboBoxItem Tag="blue" Content="Azul"/><ComboBoxItem Tag="green" Content="Verde"/><ComboBoxItem Tag="orange" Content="Naranja"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Accesibilidad" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tamaño de letra" Style="{StaticResource MutedText}" Margin="4,9,4,0"/>
                                    <ComboBox x:Name="FontScaleBox">
                                        <ComboBoxItem Tag="0.9" Content="Compacto (90 %)"/><ComboBoxItem Tag="1" Content="Normal (100 %)"/><ComboBoxItem Tag="1.15" Content="Grande (115 %)"/><ComboBoxItem Tag="1.3" Content="Muy grande (130 %)"/><ComboBoxItem Tag="1.5" Content="Máximo (150 %)"/>
                                    </ComboBox>
                                    <CheckBox x:Name="HighContrastBox" Content="Alto contraste" Margin="5,9,5,3" ToolTip="Aumenta el contraste de bordes y textos secundarios"/>
                                    <CheckBox x:Name="ReducedMotionBox" Content="Reducir movimiento" Margin="5,3" ToolTip="Evita animaciones decorativas presentes o futuras"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Modo widget" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="StartInWidgetBox" Content="Arrancar en modo widget" Margin="5,10,5,3"/>
                                    <CheckBox x:Name="AlwaysOnTopBox" Content="Mantener siempre visible" Margin="5,3"/>
                                    <TextBlock Text="El widget recuerda su posición. Escape vuelve a la aplicación completa." TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeSmall}" Margin="5,9,5,0"/>
                                    <Separator Margin="0,12,0,8"/>
                                    <TextBlock Text="Datos y soporte" FontWeight="SemiBold"/>
                                    <Button Content="Exportar historial CSV" Click="ExportDataClick" Margin="0,7,0,2" AutomationProperties.Name="Exportar historial a CSV"/>
                                    <Button Content="Crear copia de seguridad" Click="BackupDataClick" Margin="0,2" AutomationProperties.Name="Crear copia de seguridad"/>
                                    <Button Content="Abrir carpeta de datos" Click="OpenDataFolderClick" Margin="0,2" AutomationProperties.Name="Abrir carpeta de datos y diagnóstico"/>
                                    <Button Content="Acerca de TimeTracker" Click="AboutClick" Margin="0,2" AutomationProperties.Name="Información y privacidad"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Grid.Row="5" Content="Guardar preferencias" Click="SavePreferencesClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Plantillas semanales" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Configura las horas previstas para cada día de una semana tipo" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TemplateModeText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Plantilla" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <ComboBox x:Name="TemplateBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="TemplateSelected"/>
                            <Button Grid.Column="2" Content="+  Nueva plantilla" Click="NewTemplateClick" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Nombre de la plantilla" Style="{StaticResource MutedText}"/>
                                    <TextBox x:Name="TemplateNameBox" Margin="0,5,0,0"/>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="12" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Cómo introducir las horas" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="Usa 8,5 u 8.5. Indica 0 en los días no laborables." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid x:Name="ScheduleDaysGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False" RowHeight="25" MinRowHeight="25">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Día de la semana" Binding="{Binding Day}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Horas" Binding="{Binding Hours}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Eliminar plantilla" Click="DeleteTemplateClick" Style="{StaticResource DangerButton}"/>
                            <Button Content="Guardar plantilla" Click="SaveTemplateClick" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18" MinHeight="360">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Success}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Periodos del calendario" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Asigna una plantilla a un intervalo recurrente · Fechas en formato dd/MM" Style="{StaticResource MutedText}" FontSize="{DynamicResource FontSizeCaption}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource SuccessSoft}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="PeriodModeText" Foreground="{DynamicResource Success}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <DataGrid x:Name="PeriodsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="PeriodSelected" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Periodo" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Desde" Binding="{Binding StartText}" Width="76"/>
                                        <DataGridTextColumn Header="Hasta" Binding="{Binding EndText}" Width="76"/>
                                        <DataGridTextColumn Header="Plantilla" Binding="{Binding TemplateName}" Width="210"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Datos del periodo" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Grid.Row="1" Text="Nombre" Style="{StaticResource MutedText}" Margin="4,12,4,0"/>
                                    <TextBox Grid.Row="2" x:Name="PeriodNameBox"/>
                                    <Grid Grid.Row="3" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Desde (dd/MM)" Style="{StaticResource MutedText}" Margin="4,0"/><TextBox x:Name="PeriodStartBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Hasta (dd/MM)" Style="{StaticResource MutedText}" Margin="4,0"/><TextBox x:Name="PeriodEndBox"/></StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock Text="Plantilla semanal" Style="{StaticResource MutedText}" Margin="4,0"/><ComboBox x:Name="PeriodTemplateBox" DisplayMemberPath="Name"/></StackPanel>
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                        <Button Content="Nuevo" Click="NewPeriodClick"/>
                                        <Button Content="Eliminar" Click="DeletePeriodClick" Style="{StaticResource DangerButton}"/>
                                        <Button Content="Guardar" Click="SavePeriodClick" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
