<Window x:Class="TimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker" Icon="Assets/TimeTracker.ico" Width="1080" Height="720" MinWidth="880" MinHeight="580"
        Topmost="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown">
    <Grid Margin="18">
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.08" Color="#263247"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Accent}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="TimeTracker" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Registro personal de actividad" Style="{StaticResource MutedText}" FontSize="12"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceMuted}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="{StaticResource TextSecondary}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeaderStatusText" Text="Sin tarea activa" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="TabsSelectionChanged" Margin="18,0,18,18">
                    <TabItem Header="Ahora">
                        <Grid Margin="4,18,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}" Background="#F8F7FE" BorderBrush="#DAD5F8" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border x:Name="ActiveStateBadge" Background="{StaticResource SuccessSoft}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed">
                                            <TextBlock Text="EN CURSO" Foreground="{StaticResource Success}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="ActiveTitle" Text="Sin tarea activa" Style="{StaticResource PageTitle}"/>
                                        <TextBlock x:Name="ActiveDetail" Text="Elige proyecto, épica y actividad" Style="{StaticResource MutedText}" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Clock" Grid.Column="1" Text="00:00:00" FontSize="40" FontWeight="Light" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Nueva imputación" Style="{StaticResource SectionTitle}" Margin="4,0,0,10"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Proyecto" Style="{StaticResource MutedText}" Margin="4,0"/>
                                        <TextBlock Grid.Column="1" Text="Épica" Style="{StaticResource MutedText}" Margin="4,0"/>
                                        <TextBlock Grid.Column="2" Text="Actividad" Style="{StaticResource MutedText}" Margin="4,0"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ProjectBox" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="ProjectChanged"/>
                                        <ComboBox x:Name="EpicBox" Grid.Column="1" IsEditable="True"/>
                                        <ComboBox x:Name="ActivityBox" Grid.Column="2" IsEditable="True" DisplayMemberPath="Display"/>
                                    </Grid>
                                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                        <TextBlock Text="Comentario" Style="{StaticResource MutedText}" Margin="4,0"/>
                                        <TextBox x:Name="CommentBox" ToolTip="Ticket, motivo o comentario"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="Detener" Click="StopClick" Style="{StaticResource DangerButton}"/>
                                        <Button Content="Iniciar / cambiar" Click="StartClick" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Recientes" Style="{StaticResource SectionTitle}" Margin="4,2"/>
                                    <TextBlock Grid.Row="1" Text="Pulsa una tarea para continuarla" Style="{StaticResource MutedText}" FontSize="12" Margin="4,2,4,10"/>
                                    <ListBox x:Name="RecentList" Grid.Row="2" SelectionChanged="RecentSelected" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ItemsControl ItemsSource="{Binding DisplayFields}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Text}" FontWeight="{Binding FontWeight}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Día">
                        <Grid Margin="4,18,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="&#xE72B;" ToolTip="Día anterior" Click="PreviousDayClick" Style="{StaticResource IconButton}"/>
                                        <DatePicker x:Name="DayPicker" Width="142" SelectedDateChanged="DayChanged" Margin="4,0"/>
                                        <Button Content="Hoy" ToolTip="Ir a hoy" Click="TodayClick" MinWidth="58" Margin="0,0,4,0"/>
                                        <Button Content="&#xE72A;" ToolTip="Día siguiente" Click="NextDayClick" Style="{StaticResource IconButton}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Enter/F2 edita · Ctrl+Z deshace · Escribe 1020 para 10:20" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0"/>
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceMuted}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="DayStatusText" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                <DataGrid x:Name="DayGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False" RowHeight="38" MinRowHeight="38" IsReadOnly="False" RowHeaderWidth="50" ClipboardCopyMode="None" BeginningEdit="BeginningEdit" CellEditEnding="CellEditEnding" PreparingCellForEdit="PreparingCellForEdit" PreviewKeyDown="DayGridKeyDown" SelectionUnit="CellOrRowHeader" SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Inicio" Binding="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="78"/>
                                        <DataGridTextColumn Header="Fin" Binding="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="78"/>
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding Project, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                        <DataGridTextColumn Header="Épica" Binding="{Binding Epic, UpdateSourceTrigger=PropertyChanged}" Width="145"/>
                                        <DataGridTextColumn Header="Actividad" Binding="{Binding Activity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Comentario" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="Tiempo" Binding="{Binding Duration}" IsReadOnly="True" Width="82"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Eliminar fila" Click="DeleteClick" Style="{StaticResource DangerButton}"/>
                                <Button Content="+  Añadir línea" Click="AddRowClick" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Semana / SAP">
                        <Grid Margin="4,18,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="150"/><ColumnDefinition Width="82"/><ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="&#xE72B;" ToolTip="Periodo anterior" Click="PreviousWeekClick" Style="{StaticResource IconButton}"/>
                                    <DatePicker x:Name="WeekPicker" Grid.Column="1" SelectedDateChanged="WeekChanged"/>
                                    <Button Grid.Column="2" Content="Actual" ToolTip="Ir a la semana actual" Click="CurrentWeekClick" Width="72" MinWidth="0" Padding="10,8"/>
                                    <Button Grid.Column="3" Content="&#xE72A;" ToolTip="Periodo siguiente" Click="NextWeekClick" Style="{StaticResource IconButton}"/>
                                    <TextBlock x:Name="WeekNumberText" Grid.Column="4" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                    <TextBlock Grid.Column="5" Text="El periodo respeta el inicio de semana configurado" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <TabControl Grid.Row="2">
                                <TabItem Header="Detalle diario">
                                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Margin="0,8,0,0">
                                        <DataGrid x:Name="WeekGrid" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="WeekCellEditEnding" MouseDoubleClick="WeekRowDoubleClick">
                                            <DataGrid.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F2F4F8" BorderBrush="#E1E5EB" BorderThickness="0,1" Padding="12,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Items[0].DailyTotalText}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text=" / "/>
                                                                        <TextBlock Text="{Binding Items[0].DailyExpectedText}" Foreground="{StaticResource TextSecondary}"/>
                                                                        <TextBlock Text="   "/>
                                                                        <TextBlock Text="{Binding Items[0].DailyStatusText}" Foreground="{Binding Items[0].DailyStatusBrush}" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </DataGrid.GroupStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Proyecto" Binding="{Binding Project, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                                                <DataGridTextColumn Header="Épica" Binding="{Binding Epic, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                                <DataGridTextColumn Header="Registrado" Binding="{Binding RegisteredText, Mode=OneWay}" IsReadOnly="True" Width="105"/>
                                                <DataGridTextColumn Header="Añadido" Binding="{Binding AddedText, UpdateSourceTrigger=LostFocus}" Width="95"/>
                                                <DataGridTextColumn Header="Total" Binding="{Binding TotalText, Mode=OneWay}" IsReadOnly="True" Width="105"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </TabItem>
                                <TabItem Header="Resumen Proyecto - Épica">
                                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Margin="0,8,0,0">
                                        <DataGrid x:Name="WeekSummaryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AlternationCount="2" AlternatingRowBackground="#ECECEC" HorizontalScrollBarVisibility="Auto" MouseDoubleClick="WeekSummaryCellDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Proyecto - Épica" Binding="{Binding ProjectEpic}" Width="*" MinWidth="220"/>
                                                <DataGridTemplateColumn Header="" Width="112">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Copiar" Click="CopyWeekSummaryRowClick" Width="84" MinWidth="0" Padding="8,3" Margin="2"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </TabItem>
                            </TabControl>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,10,4,0">
                                <Button Content="Copiar detalle para SAP" Click="CopyWeekClick"/>
                                <Button Content="Copiar todo el resumen" Click="CopyWeekSummaryClick" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Informes">
                        <Grid Margin="4,18,4,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="126"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Desde" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="ReportFromPicker" Grid.Column="1" Margin="6,0" SelectedDateChanged="ReportDatesChanged"/>
                                    <TextBlock Grid.Column="2" Text="Hasta" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <DatePicker x:Name="ReportToPicker" Grid.Column="3" Margin="6,0" SelectedDateChanged="ReportDatesChanged"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Copiar para Excel" Click="CopyReportClick"/>
                                        <Button Content="Actualizar" Click="RefreshReportClick" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="ReportBackButton" Content="←  Volver" Click="ReportBackClick" Visibility="Collapsed"/>
                                <TextBlock x:Name="ReportLevelText" Grid.Column="1" Text="Tiempo por proyecto" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="8">
                                    <Viewbox Stretch="Uniform"><Canvas x:Name="ReportPie" Width="620" Height="430" Background="Transparent" MouseLeftButtonUp="ReportPieClick"/></Viewbox>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                    <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ReportGridSelected">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Concepto" Binding="{Binding Label, Mode=OneWay}" Width="*"/>
                                            <DataGridTextColumn Header="Horas" Binding="{Binding HoursText, Mode=OneWay}" Width="85"/>
                                            <DataGridTextColumn Header="%" Binding="{Binding PercentageText, Mode=OneWay}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="SettingsTab" ToolTip="Configuración">
                        <TabItem.Header>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                        </TabItem.Header>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
