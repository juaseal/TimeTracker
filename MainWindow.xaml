<Window x:Class="TimeTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TimeTracker" Width="900" Height="610" MinWidth="720" MinHeight="480" Topmost="True" WindowStartupLocation="CenterScreen" Background="#F7F7FB" PreviewKeyDown="WindowKeyDown">
 <Grid Margin="16">
  <TabControl x:Name="Tabs" SelectionChanged="TabsSelectionChanged">
   <TabItem Header="  Ahora  "><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="ActiveTitle" Text="Sin tarea activa" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ActiveDetail" Foreground="#666" FontSize="15" Margin="0,5"/><TextBlock x:Name="Clock" Text="00:00:00" FontSize="44" FontWeight="Light" Margin="0,14"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="ProjectBox" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="ProjectChanged"/><ComboBox x:Name="EpicBox" Grid.Column="1" IsEditable="True"/><ComboBox x:Name="ActivityBox" Grid.Column="2" IsEditable="True" DisplayMemberPath="Display"/></Grid>
    <StackPanel Grid.Row="2"><TextBox x:Name="CommentBox" ToolTip="Ticket, motivo o comentario"/><TextBlock Text="Recientes en el proyecto · un clic para iniciar" FontWeight="SemiBold" Margin="4,14,4,6"/><ListBox x:Name="RecentList" DisplayMemberPath="Display" SelectionChanged="RecentSelected" MaxHeight="180"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Detener" Click="StopClick"/><Button Content="Iniciar / cambiar" Click="StartClick" Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="  Día  "><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><DatePicker x:Name="DayPicker" SelectedDateChanged="DayChanged"/><TextBlock Text="Un clic selecciona · Enter/F2 edita · Ctrl+Z deshace · Horas: 1020 → 10:20" Foreground="#666" VerticalAlignment="Center" Margin="12,0"/></StackPanel><DataGrid x:Name="DayGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False" RowHeight="34" MinRowHeight="34" IsReadOnly="False" RowHeaderWidth="50" ClipboardCopyMode="None" BeginningEdit="BeginningEdit" CellEditEnding="CellEditEnding" PreparingCellForEdit="PreparingCellForEdit" PreviewKeyDown="DayGridKeyDown" SelectionUnit="CellOrRowHeader" SelectionMode="Extended" Margin="0,10"><DataGrid.Columns><DataGridTextColumn Header="Inicio" Binding="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="76"/><DataGridTextColumn Header="Fin" Binding="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="76"/><DataGridTextColumn Header="Proyecto" Binding="{Binding Project, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="Épica" Binding="{Binding Epic, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Actividad" Binding="{Binding Activity, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Comentario" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Tiempo" Binding="{Binding Duration}" IsReadOnly="True" Width="75"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2"><TextBlock x:Name="DayStatusText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+ Añadir línea" Click="AddRowClick" Background="{StaticResource Accent}" Foreground="White"/><Button Content="Eliminar fila" Click="DeleteClick"/></StackPanel></Grid></Grid></TabItem>
   <TabItem Header="  Semana / SAP  "><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DatePicker x:Name="WeekPicker" Height="30" Padding="4,1" Margin="0" SelectedDateChanged="WeekChanged"/><Button Grid.Column="1" Content="←" ToolTip="Semana anterior" Click="PreviousWeekClick" Width="30" Height="30" Padding="0" Margin="4,0,0,0" FontSize="15"/><Button Grid.Column="2" Content="→" ToolTip="Semana siguiente" Click="NextWeekClick" Width="30" Height="30" Padding="0" Margin="4,0,0,0" FontSize="15"/><TextBlock x:Name="WeekNumberText" Grid.Column="3" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,4,0"/><TextBlock Grid.Column="4" Text="Añadido acepta 1.5 o -0.5 · Doble clic en una fila para ver sus tareas" Foreground="#666" VerticalAlignment="Center" Margin="14,0"/></Grid><DataGrid x:Name="WeekGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CellEditEnding="WeekCellEditEnding" MouseDoubleClick="WeekRowDoubleClick" Margin="0,9,0,10"><DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#F1F2F6" BorderBrush="#D5D7DE" BorderThickness="0,1,0,1" Padding="8,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding Items[0].DailyTotalText}" FontWeight="SemiBold"/><TextBlock Text=" / "/><TextBlock Text="{Binding Items[0].DailyExpectedText}"/><TextBlock Text="  "/><TextBlock Text="{Binding Items[0].DailyStatusText}" Foreground="{Binding Items[0].DailyStatusBrush}" FontWeight="SemiBold"/></StackPanel></Grid></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle><DataGrid.Columns><DataGridTextColumn Header="Proyecto" Binding="{Binding Project, Mode=OneWay}" IsReadOnly="True" Width="180"/><DataGridTextColumn Header="Épica" Binding="{Binding Epic, Mode=OneWay}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Registrado" Binding="{Binding RegisteredText, Mode=OneWay}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Añadido" Binding="{Binding AddedText, UpdateSourceTrigger=LostFocus}" Width="90"/><DataGridTextColumn Header="Total" Binding="{Binding TotalText, Mode=OneWay}" IsReadOnly="True" Width="100"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Copiar para SAP" HorizontalAlignment="Right" Click="CopyWeekClick"/></Grid></TabItem>
   <TabItem Header="  Informes  "><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Desde" VerticalAlignment="Center"/><DatePicker x:Name="ReportFromPicker" Grid.Column="1" Height="28" Padding="3,0" Margin="4,0" SelectedDateChanged="ReportDatesChanged"/><TextBlock Grid.Column="2" Text="Hasta" VerticalAlignment="Center" Margin="12,0,0,0"/><DatePicker x:Name="ReportToPicker" Grid.Column="3" Height="28" Padding="3,0" Margin="4,0" SelectedDateChanged="ReportDatesChanged"/><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Copiar para Excel" Click="CopyReportClick"/><Button Content="Actualizar" Click="RefreshReportClick"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ReportBackButton" Content="← Volver" Click="ReportBackClick" Visibility="Collapsed"/><TextBlock x:Name="ReportLevelText" Grid.Column="1" Text="Tiempo por proyecto" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions><Viewbox Stretch="Uniform" Margin="4"><Canvas x:Name="ReportPie" Width="620" Height="430" Background="Transparent" MouseLeftButtonUp="ReportPieClick"/></Viewbox><DataGrid x:Name="ReportGrid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ReportGridSelected"><DataGrid.Columns><DataGridTextColumn Header="Concepto" Binding="{Binding Label, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Horas" Binding="{Binding HoursText, Mode=OneWay}" Width="85"/><DataGridTextColumn Header="%" Binding="{Binding PercentageText, Mode=OneWay}" Width="70"/></DataGrid.Columns></DataGrid></Grid></Grid></TabItem>
   <TabItem x:Name="SettingsTab" Header="  ⚙  "/>
  </TabControl>
 </Grid>
</Window>
